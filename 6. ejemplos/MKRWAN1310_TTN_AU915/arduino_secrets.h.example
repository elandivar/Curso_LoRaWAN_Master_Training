/*
 * Credenciales del nodo — PLANTILLA.
 *
 * Copia este archivo como  arduino_secrets.h  (en esta misma carpeta) y
 * sustituye los ceros por los valores que da TTN al registrar el dispositivo.
 * El archivo arduino_secrets.h está en .gitignore: tus claves reales nunca
 * deben subirse al repositorio.
 *
 * El DevEUI NO va aquí: viene grabado de fábrica en el módulo Murata y el
 * sketch lo imprime por el puerto serie al arrancar.
 *
 * Cópialos de TTN tal cual, en formato MSB (el que muestra la consola por
 * defecto), sin espacios ni 0x.
 */

#define SECRET_APP_EUI  "0000000000000000"                  // JoinEUI / AppEUI
#define SECRET_APP_KEY  "00000000000000000000000000000000"  // AppKey (32 hex)
